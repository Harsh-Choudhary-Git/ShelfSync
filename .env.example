# -------------------------------------------------------------
# ShelfSync - Environment Variables & Secrets Configuration
# -------------------------------------------------------------

# PostgreSQL Database Configuration
POSTGRES_DB=shelfsync
POSTGRES_USER=shelfsync_user
POSTGRES_PASSWORD=shelfsync_secure_password
POSTGRES_PORT=5432

# Spring Boot Backend Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT Security (Must be at least 256-bit hexadecimal string)
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# ==========================================
# ShelfSync - Full Stack Environment Configuration
# ==========================================

# --- Backend Configuration (Spring Boot) ---
PORT=8080
DATABASE_URL=jdbc:h2:file:./data/shelfsync;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Firebase Admin Configuration (Backend)
FIREBASE_PROJECT_ID=shelfsync-demo
# Optional: Path to Firebase Service Account private key JSON file (if not using Application Default Credentials)
# FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json

# --- Frontend Configuration (Vite + React) ---
VITE_API_BASE_URL=http://localhost:8080/api

# Firebase Web App Credentials
VITE_FIREBASE_API_KEY=AIzaSyDemoDummyApiKeyForShelfSync
VITE_FIREBASE_AUTH_DOMAIN=shelfsync-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shelfsync-demo
VITE_FIREBASE_STORAGE_BUCKET=shelfsync-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
